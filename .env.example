# =============================================================================
# iBshop Enterprise Platform — Runtime Environment Configuration (.env)
# =============================================================================
# Copy this file to `.env` (`cp .env.example .env`) and adjust values as needed.
# Changing any setting here only requires `docker compose up -d` (NO rebuild!).

# 1. Release Version Tag
IBSHOP_VERSION=v0.1.3-20261109.4
IBSHOP_RELEASE_DATE=2026-11-09

# 2. Exposed Host Ports on the Linux Server
PORTAL_HTTP_PORT=8080
ADMIN_HTTP_PORT=8081
API_DIRECT_PORT=5215
SQLSERVER_HOST_PORT=14333

# 3. SQL Server 2022 & Redis Settings
# Note: If connecting to an external SQL Server instead of the container,
# replace `Server=sqlserver,1433` with your SQL Server IP/hostname in DB_CONNECTION_STRING.
DB_SA_PASSWORD=iBshop@StrongPass2026!
MSSQL_EDITION=Developer
DB_CONNECTION_STRING=Server=sqlserver,1433;Database=iBshopDb;User Id=sa;Password=iBshop@StrongPass2026!;TrustServerCertificate=True;MultipleActiveResultSets=True
REDIS_CONNECTION_STRING=redis:6379

# 4. Automatic Database Migration & Initial Data Seeding
DB_AUTO_MIGRATE=true
DB_AUTO_SEED=true

# 5. CORS & Cookie Security (For HTTP IP Testing vs Production HTTPS Domain)
# Set CORS_ALLOW_ANY_ORIGIN=true on internal test servers so any IP/hostname works.
CORS_ALLOW_ANY_ORIGIN=true
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://127.0.0.1:8080,http://127.0.0.1:8081
COOKIE_SECURE_POLICY=SameAsRequest
COOKIE_SAMESITE=Lax
ADMIN_ENABLE_HEADER_FALLBACK=true

# 6. Swagger UI, Angular SSR Host Check & HTTPS Redirection
ENABLE_SWAGGER=true
USE_HTTPS_REDIRECTION=false
NG_ALLOWED_HOSTS=*
SSR_API_URL=http://cms-api:8080
